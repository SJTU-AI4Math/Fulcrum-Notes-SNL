    },
    "contribution_info": null,
    "pointer": null
  },
  {
    "id": "FP.prop.identityMonad",
    "kind": "property",
    "title": "Identity is a Monad",
    "content": {
      "snl": "thm-hyp(Type.judge(@x,A),FP.statement(Eq(FP.pure(FP.Identity,x),x),%, and %,Eq(FP.map(FP.Identity,x,@f),Type.apply(f,x)),%, and %,Eq(FP.flatten(FP.Identity,x),x)))"
    },
    "contribution_info": null,
    "pointer": null
  },
  {
    "id": "FP.def.option",
    "kind": "definition",
    "title": "Option / Maybe",
    "content": {
      "snl": "def-inductive(FP.Option(A),struct[enumerate](member[colon](FP.none,Type.to(Type,FP.Option(A))),member[colon](FP.some,Type.to(A,FP.Option(A)))))"
    },
    "contribution_info": null,
    "pointer": null
  },
  {
    "id": "FP.def.optionBind",
    "kind": "property",
    "title": "Option / Maybe Bind",
    "content": {
      "snl": "thm-hyp(Type.judge(@x,FP.Option(A)),Eq(FP.bind(FP.Option,x,@f),FP.bind(FP.Option,x,f)))"
    },
    "contribution_info": null,
    "pointer": null
  },
  {
    "id": "FP.xmp.option",
    "kind": "example",
    "title": "Option / Maybe Monad",
    "content": {
      "snl": "thm-hyp(Type.judge(@x,FP.Option(A)),Eq(FP.map(FP.Option,x,@f),FP.bind(FP.Option,x,Type.lambda(@a,FP.pure(FP.Option,Type.apply(f,a))))))"
    },
    "contribution_info": null,
