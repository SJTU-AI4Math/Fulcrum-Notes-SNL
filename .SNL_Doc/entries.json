  },
  {
    "id": "Algebra.def.orbit",
    "kind": "definition",
    "title": "Orbit",
    "content": {
      "snl": "def(Algebra.Orb,Set.sep-typed(@y,X@Algebra.def.groupAction,Logic.exists-typed(@g,G@Algebra.ctxt.G,Eq(Type.apply[paren](Type.apply[paren](alpha@Algebra.def.groupAction,g),x@Algebra.def.groupAction),y))))"
    },
    "contribution_info": null,
