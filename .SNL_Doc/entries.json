  {
    "id": "Set.ctxt.1",
    "kind": "context",
    "title": "T, A, B",
    "content": {
      "snl": "%In this section, we make the following conventions: %"
    },
    "contribution_info": null,
    "pointer": null
  },
  {
    "id": "Set.ctxt.T",
    "kind": "context",
    "title": "$T$",
    "content": {
      "snl": "Type.judge(@T,Type)"
    },
    "contribution_info": null,
    "pointer": null
  },
  {
    "id": "Set.ctxt.AB",
    "kind": "context",
    "title": "$A, B$",
    "content": {
      "snl": "Type.judge(hyp-list(@A,@B),Set(T))"
    },
    "contribution_info": null,
    "pointer": null
  },
  {
    "id": "Set.subsec.basic",
    "kind": "subsection",
    "title": "Basic Concepts",
    "content": {},
    "contribution_info": null,
    "pointer": null
  },
  {
    "id": "Set.subsec.relations",
    "kind": "subsection",
    "title": "Relations",
    "content": {},
    "contribution_info": null,
    "pointer": null
  },
  {
    "id": "Set.subsec.operations",
    "kind": "subsection",
    "title": "Operations",
    "content": {},
    "contribution_info": null,
    "pointer": null
  },
  {
    "id": "Set.def.set",
    "kind": "definition",
    "title": "Set",
    "content": {
      "snl": "def(Set(T), Type.to(T, Proposition))"
    },
    "contribution_info": null,
    "pointer": null
  },
  {
    "id": "Set.def.mem",
    "kind": "definition",
    "title": "Membership",
    "content": {
      "snl": "def-hyp(hyp-list(Type.judge(@x,T),Type.judge(@S,Set(T))),Set.mem(x,S),Type.apply[paren](S,x))"
    },
    "contribution_info": null,
    "pointer": null
  },
  {
    "id": "Set.def.sep",
    "kind": "definition",
    "title": "Set Comprehension",
    "content": {
      "snl": "def-hyp(Type.judge[paren](@P,Type.to(T,Proposition)),Set.sep-typed(@x,T,P(x)),P)"
    },
    "contribution_info": null,
    "pointer": null
  },
  {
    "id": "Set.def.emptyset",
    "kind": "definition",
    "title": "Empty Set",
    "content": {
      "snl": "def(Set.emptyset[slim],Set.sep-typed(@x,T,Logic.false))"
    },
    "contribution_info": null,
    "pointer": null
  },
  {
    "id": "Set.def.univ",
    "kind": "definition",
    "title": "Universal Set",
    "content": {
      "snl": "def(Set.univ,Set.sep-typed(@x,T,Logic.neg(Logic.false)))"
    },
    "contribution_info": null,
    "pointer": null
  },
  {
    "id": "Set.def.subset",
    "kind": "definition",
    "title": "Subset",
    "content": {
      "snl": "def-hyp(Type.judge[paren](hyp-list(@s,@t),Set(T)),Set.subset(s,t),Logic.forall(@x,Logic.implies(Set.mem(x,s),Set.mem(x,t))))"
    },
    "contribution_info": null,
    "pointer": null
  },
  {
    "id": "Set.def.ext",
    "kind": "property",
    "title": "Set Extensionality",
    "content": {
      "snl": "thm-hyp(Type.judge[paren](hyp-list(A,B),Set(T)),Logic.iff(Eq(A,B), Logic.forall-typed(@x, T,parentheses(Logic.iff(Set.mem(x,A),Set.mem(x,B)))),Logic.and(Set.subset(A,B),Set.subset(B,A))))"
    },
    "contribution_info": null,
    "pointer": null
  },
  {
    "id": "Set.def.nmem",
    "kind": "definition",
    "title": "Membership Negation",
    "content": {
      "snl": "def-hyp[predicate](hyp-list(Type.judge(@x,T),Type.judge(S,Set(T))),Set.nmem(x,S),Logic.neg(Set.mem(x,S)))"
    },
    "contribution_info": null,
    "pointer": null
  },
  {
    "id": "Set.def.union",
    "kind": "definition",
    "title": "Union of sets",
    "content": {
      "snl": "def-hyp(Type.judge[paren](hyp-list(A,B),Set(T)),Set.union(A,B),Set.sep-typed(@x,T,Logic.or(Set.mem(x,A),Set.mem(x,B))))"
    },
    "contribution_info": null,
    "pointer": null
  },
  {
    "id": "Set.def.inter",
    "kind": "definition",
    "title": "Intersection of sets",
    "content": {
      "snl": "def-hyp(Type.judge[paren](hyp-list(@s,@t),Set(T)),Set.inter(s,t),Set.sep-typed(@x,T,Logic.and(Set.mem(x,s),Set.mem(x,t))))"
    },
    "contribution_info": null,
    "pointer": null
  },
  {
    "id": "Set.def.diff",
    "kind": "definition",
    "title": "Set Difference",
    "content": {
      "snl": "def-hyp(Type.judge[paren](hyp-list(@s,@t),Set(T)),Set.diff[backslash](s,t),Set.sep-typed(@x,T,Logic.and(Set.mem(x,s),Set.nmem(x,t))))"
    },
    "contribution_info": null,
    "pointer": null
  },
  {
    "id": "Set.def.compl",
    "kind": "definition",
    "title": "Complement",
    "content": {
      "snl": "def-hyp(Type.judge(@S,Set(T)),Set.compl(S),Set.sep-typed(@x,T,Set.nmem(x,S)))"
    },
    "contribution_info": null,
    "pointer": null
  },
  {
    "id": "Set.def.powerset",
    "kind": "definition",
    "title": "Power Set",
    "content": {
      "snl": "def-hyp(Type.judge[paren](@s,Set(T)),Set.powerset(s),Set.sep-typed(@t,Set(T),Set.subset(t,s)))"
    },
    "contribution_info": null,
    "pointer": null
  },
  {
    "id": "Set.def.symmetric_difference",
    "kind": "definition",
    "title": "Symmetric Difference",
    "content": {
      "snl": "def-hyp(Type.judge[paren](hyp-list(A,B),Set(T)),Set.SymmDiff(A,B),Set.diff(parentheses(Set.union(A,B)),parentheses(Set.inter(A,B))))"
    },
    "contribution_info": null,
    "pointer": null
  },
