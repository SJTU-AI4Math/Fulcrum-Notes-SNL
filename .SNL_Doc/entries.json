  {
    "id": "Algebra.def.semigroup",
    "kind": "definition",
    "title": "Semigroup",
    "content": {
      "snl": "def[predicate-display](Algebra.Semigroup(G@Algebra.ctxt.G,$\\cdot$@Algebra.ctxt.mul), struct[enumerate](member[colon](%Associativity%, Logic.forall-typed[paren](list-partial(@x,@y,@z),G@Algebra.ctxt.G,Eq(Algebra.mul[dot](Algebra.mul[dot](x,y),z),Algebra.mul[dot](x,parentheses(Algebra.mul[dot](y,z))))))))"
    },
    "contribution_info": null,
    "pointer": null
  },
  {
    "id": "Algebra.def.monoid",
    "kind": "definition",
    "title": "Monoid",
    "content": {
      "snl": "def[predicate-display](Algebra.Monoid(G@Algebra.ctxt.G,$\\cdot$@Algebra.ctxt.mul), struct[enumerate](member[colon](%Associativity%, Logic.forall-typed[paren](list-partial(@x,@y,@z),G@Algebra.ctxt.G,Eq(Algebra.mul[dot](Algebra.mul[dot](x,y),z),Algebra.mul[dot](x,parentheses(Algebra.mul[dot](y,z)))))), member[colon](%Identity%, Logic.exists-typed(@e,G@Algebra.ctxt.G,Logic.forall-typed(@a,G@Algebra.ctxt.G,Logic.and(Eq(Algebra.mul[dot](e,a),a),Eq(Algebra.mul[dot](a,e),a)))))))"
    },
    "contribution_info": null,
    "pointer": null
  },
  {
    "id": "Algebra.prop.identityUnique",
    "kind": "property",
    "title": "Identity Uniqueness",
    "content": {
      "snl": "def-hyp(list-partial(Type.judge(@ep,G@Algebra.ctxt.G),Logic.and(Logic.forall-typed(@a,G@Algebra.ctxt.G,Eq(Algebra.mul[dot](ep,a),a)),Logic.forall-typed(@a,G@Algebra.ctxt.G,Eq(Algebra.mul[dot](a,ep),a)))), Eq(ep,e@Algebra.def.monoid), Logic.true)"
    },
    "contribution_info": null,
    "pointer": null
  },
  {
    "id": "Algebra.def.group",
    "kind": "definition",
    "title": "Group",
    "content": {
      "snl": "def[predicate-display](Algebra.Group(G@Algebra.ctxt.G,dot@Algebra.ctxt.mul), struct[enumerate](member[colon](%Associativity%, Logic.forall[paren](list-partial(@x,@y,@z),G@Algebra.ctxt.G,Eq(Algebra.mul[dot](Algebra.mul[dot](x,y),z),Algebra.mul[dot](x,Algebra.mul[dot](y,z))))), member[colon](%Identity%, Logic.exists-typed(@e,G@Algebra.ctxt.G,Logic.forall-typed[paren](@a,G@Algebra.ctxt.G,Logic.and(Eq(Algebra.mul[dot](e,a),a),Eq(Algebra.mul[dot](a,e),a))))), member[colon](%Inverse%, Logic.forall[paren](@a,G@Algebra.ctxt.G,Logic.exists-typed(@b,G@Algebra.ctxt.G,Logic.and(Eq(Algebra.mul[dot](b,a),e@Algebra.def.monoid),Eq(Algebra.mul[dot](a,b),e@Algebra.def.monoid)))))))"
    },
    "contribution_info": null,
    "pointer": null
  },
