    "content": {
      "snl": "def(Logic.implies(P@Logic.ctxt.PQ,Q@Logic.ctxt.PQ), Type.judge(Logic.implies(P@Logic.ctxt.PQ,Q@Logic.ctxt.PQ), Proposition))"
    },
    "contribution_info": null,
    "pointer": null
  },
  {
    "id": "Logic.def.neg",
    "kind": "definition",
