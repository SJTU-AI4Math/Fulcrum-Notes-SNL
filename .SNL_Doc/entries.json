      "snl": "def(Algebra.Im,Set.sep-typed(@y,H@Algebra.def.groupHom,Logic.exists-typed(@x,G@Algebra.ctxt.G,Eq(Type.apply[paren](f@Algebra.def.groupHom,x),y))))"
    },
    "contribution_info": null,
