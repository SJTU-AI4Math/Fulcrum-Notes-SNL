      "snl": "def(Logic.implies(P,Q),Type.to(P,Q))"
    },
    "contribution_info": null,
    "pointer": null
  },
  {
    "id": "Logic.def.neg",
    "kind": "definition",
    "title": "Negation",
    "content": {
      "snl": "def(Logic.neg(P),Type.to(P,Proposition))"
    },
    "contribution_info": null,
    "pointer": null
  },
  {
    "id": "Logic.def.iff",
    "kind": "definition",
    "title": "Equivalence",
    "content": {
      "snl": "def-struct[prop](Logic.iff(P,Q),struct(Type.judge(%right%,Logic.implies(P,Q)),Type.judge(%left%,Logic.implies(Q,P))))"
    },
    "contribution_info": null,
    "pointer": null
  },
  {
    "id": "Logic.def.forall",
    "kind": "definition",
    "title": "Universal Quantifier",
    "content": {
      "snl": "def(Logic.forall-typed(x,T,P(x)),Type.Pi(@x,T,P(x)))"
    },
    "contribution_info": null,
    "pointer": null
  },
  {
    "id": "Logic.def.exists",
    "kind": "definition",
    "title": "Existential Quantifier",
    "content": {
      "snl": "def-struct[prop](Logic.exists-typed(x,T,P(x)),struct(member(%Instance%,Type.judge(x,T)),Type.judge(%Property%,Type.apply(P,x))))"
    },
    "contribution_info": null,
    "pointer": null
  },
  {
    "id": "Logic.def.eq",
    "kind": "definition",
    "title": "Equality",
    "content": {
      "snl": "def-inductive[prop](Eq(a,b),ctors(Type.judge(%Reflexivity%,Logic.forall(a,Eq(a,a)))))"
    },
    "contribution_info": null,
    "pointer": null
  },
  {
    "id": "Logic.thm.eq_refl",
    "kind": "theorem",
    "title": "Reflexivity of =",
    "content": {
      "snl": "def-hyp(Type.judge(@a,T@Logic.ctxt.T), Logic.forall-typed(@a,T@Logic.ctxt.T,Eq(a,a)), Logic.true)"
    },
    "contribution_info": null,
    "pointer": null
  },
  {
    "id": "Logic.thm.eq_subst",
    "kind": "theorem",
    "title": "Substitution",
    "content": {
      "snl": "def-hyp(Type.judge[paren](list-partial(@a,@b),T@Logic.ctxt.T), Logic.implies(Eq(a,b), Logic.forall-typed(@P,Type.to(T@Logic.ctxt.T,Proposition),Logic.implies(P(a),P(b)))), Logic.true)"
    },
    "contribution_info": null,
    "pointer": null
  },
