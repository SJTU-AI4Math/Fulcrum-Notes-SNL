    "content": {
      "snl": "def(Logic.neg(P@Logic.ctxt.PQ), Type.judge(Logic.neg(P@Logic.ctxt.PQ), Proposition))"
    },
    "contribution_info": null,
    "pointer": null
  },
  {
    "id": "Logic.def.iff",
    "kind": "definition",
    "title": "Equivalence",
    "content": {
      "snl": "def(Logic.iff(P@Logic.ctxt.PQ,Q@Logic.ctxt.PQ), Type.judge(Logic.iff(P@Logic.ctxt.PQ,Q@Logic.ctxt.PQ), Proposition))"
    },
    "contribution_info": null,
    "pointer": null
  },
  {
    "id": "Logic.def.forall",
    "kind": "definition",
    "title": "Universal Quantifier",
    "content": {
      "snl": "def-hyp(Type.judge[paren](@P,Type.to(T@Logic.ctxt.T,Proposition)), Logic.forall-typed(@x,T@Logic.ctxt.T,P(x)), Type.judge(Logic.forall-typed(x,T@Logic.ctxt.T,P(x)), Proposition))"
    },
    "contribution_info": null,
    "pointer": null
  },
  {
    "id": "Logic.def.exists",
    "kind": "definition",
    "title": "Existential Quantifier",
    "content": {
      "snl": "def-hyp(Type.judge[paren](@P,Type.to(T@Logic.ctxt.T,Proposition)), Logic.exists-typed(@x,T@Logic.ctxt.T,P(x)), Type.judge(Logic.exists-typed(x,T@Logic.ctxt.T,P(x)), Proposition))"
    },
    "contribution_info": null,
    "pointer": null
  },
  {
    "id": "Logic.def.eq",
    "kind": "definition",
    "title": "Equality",
    "content": {
      "snl": "def-hyp(Type.judge[paren](hyp-list(@a,@b),T@Logic.ctxt.T), Eq(a,b), Type.judge(Eq(a,b), Proposition))"
    },
    "contribution_info": null,
    "pointer": null
  },
  {
    "id": "Logic.thm.eq_refl",
    "kind": "theorem",
    "title": "Reflexivity of =",
    "content": {
      "snl": "def-hyp(Type.judge(@a,T@Logic.ctxt.T), Logic.forall-typed(@a,T@Logic.ctxt.T,Eq(a,a)), Logic.true)"
    },
    "contribution_info": null,
    "pointer": null
  },
  {
    "id": "Logic.thm.eq_subst",
    "kind": "theorem",
    "title": "Substitution",
    "content": {
      "snl": "def-hyp(Type.judge[paren](hyp-list(@a,@b),T@Logic.ctxt.T), Logic.implies(Eq(a,b), Logic.forall-typed(@P,Type.to(T@Logic.ctxt.T,Proposition),Logic.implies(P(a),P(b)))), Logic.true)"
    },
    "contribution_info": null,
    "pointer": null
  },
