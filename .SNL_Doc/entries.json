[
  {
    "id": "Set.def.inter",
    "kind": "definition",
    "title": "Intersection of sets",
    "content": {
      "snl": "def-hyp(hyp-list(Type.judge(@T,Type), Type.judge[paren](hyp-list(@s,@t), Set(T))), Set.inter(s,t), Set.sep-typed(@x,T,Logic.and(Set.mem(x,s), Set.mem(x,t))))"
    },
    "contribution_info": null,
    "pointer": null
  },
  {
    "id": "Set.def.diff",
    "kind": "definition",
    "title": "Set Difference",
    "content": {
      "snl": "def-hyp(hyp-list(Type.judge(@T,Type), Type.judge[paren](hyp-list(@s,@t), Set(T))), Set.diff[backslash](s,t), Set.sep-typed(@x,T,Logic.and(Set.mem(x,s), Logic.neg(Set.mem(x,t)))))"
    },
    "contribution_info": null,
    "pointer": null
  },
  {
    "id": "Set.def.compl",
    "kind": "definition",
    "title": "Complement",
    "content": {
      "snl": "def-hyp(hyp-list(Type.judge(@T,Type), Type.judge[paren](@s, Set(T))), Set.compl[sup](s), Set.sep-typed(@x,T,Logic.neg(Set.mem(x,s))))"
    },
    "contribution_info": null,
    "pointer": null
  },
  {
    "id": "Set.def.powerset",
    "kind": "definition",
    "title": "Power Set",
    "content": {
      "snl": "def-hyp(hyp-list(Type.judge(@T,Type), Type.judge[paren](@s, Set(T))), Set.powerset(s), Set.sep-typed(@t, Set(T), Set.subset(t,s)))"
    },
    "contribution_info": null,
    "pointer": null
  }
