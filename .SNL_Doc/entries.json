  {
    "id": "FP.def.monad",
    "kind": "definition",
    "title": "Monad",
    "content": {
      "snl": "def-struct(FP.Monad(M),struct[enumerate](member[colon](%pure%,Type.Pi(@A,Type,Type.to(A,Type.apply(M,A)))),member[colon](%map%,Type.Pi(list-partial[formula](A,B),Type,parentheses(Type.to(parentheses(Type.to(A,B)),Type.to(A,Type.apply(M,B)))))),member[colon](%flatten%,Type.Pi(A,Type,parentheses(Type.to(Type.apply(M,Type.apply(M,A)),Type.apply(M,A)))))))"
    },
    "contribution_info": null,
    "pointer": null
  },
  {
    "id": "FP.def.bind",
    "kind": "definition",
    "title": "Bind as an Equivalent Monad Presentation",
    "content": {
      "snl": "def-hyp(FP.Monad(M),a,b)"
    },
    "contribution_info": null,
    "pointer": null
  },
  {
    "id": "FP.prop.bind-equivalence",
    "kind": "property",
    "title": "Bind is Equivalent to Map Followed by Flatten",
    "content": {
      "snl": "thm-hyp(Type.judge(@x,Type.apply(M,A)),Eq(FP.bindFromMapFlatten(M,x,@f),FP.flatten(M,FP.map(M,x,f))))"
    },
    "contribution_info": null,
    "pointer": null
  },
  {
    "id": "FP.prop.leftIdentity",
    "kind": "property",
    "title": "Monad Law: Left Identity",
    "content": {
      "snl": "thm-hyp(list-partial(Type.judge(@a,A),Type.judge(@f,Type.to(A,Type.apply(M,B)))),Eq(FP.bind(M,FP.pure(M,a),f),Type.apply(f,a)))"
    },
    "contribution_info": null,
    "pointer": null
  },
  {
    "id": "FP.prop.rightIdentity",
    "kind": "property",
    "title": "Monad Law: Right Identity",
    "content": {
      "snl": "thm-hyp(Type.judge(@x,Type.apply(M,A)),Eq(FP.bind(M,x,Type.lambda(@a,FP.pure(M,a))),x))"
    },
    "contribution_info": null,
    "pointer": null
  },
  {
    "id": "FP.prop.associativity",
    "kind": "property",
    "title": "Monad Law: Associativity",
    "content": {
      "snl": "thm-hyp(list-partial(Type.judge(@x,Type.apply(M,A)),Type.judge(@f,Type.to(A,Type.apply(M,B))),Type.judge(@g,Type.to(B,Type.apply(M,C)))),Eq(FP.bind(M,FP.bind(M,x,f),g),FP.bind(M,x,Type.lambda(@a,FP.bind(M,Type.apply(f,a),g)))))"
    },
    "contribution_info": null,
    "pointer": null
  },
  {
    "id": "FP.def.map",
    "kind": "property",
    "title": "Map is the Monad Map Operation",
    "content": {
      "snl": "thm-hyp(Type.judge(@f,Type.to(A,B)),Eq(FP.map(M,x,f),FP.bind(M,x,Type.lambda(@a,FP.pure(M,Type.apply(f,a))))))"
    },
    "contribution_info": null,
    "pointer": null
  },
  {
    "id": "FP.def.flatten",
    "kind": "property",
    "title": "Flatten is the Monad Flatten Operation",
    "content": {
      "snl": "thm-hyp(Type.judge(@x,Type.apply(M,Type.apply(M,A))),Eq(FP.flatten(M,x),FP.bind(M,x,Type.lambda(@a,a))))"
    },
    "contribution_info": null,
    "pointer": null
  },
  {
    "id": "FP.def.monadTransformer",
    "kind": "definition",
    "title": "Monad Transformer",
    "content": {
      "snl": "def-struct(FP.MonadTransformer(T),struct[enumerate](member[colon](%transformed monad%,FP.Monad(Type.apply(T,M))),member[colon](%lift%,Type.Pi(@A,Type,Type.to(Type.apply(M,A),Type.apply(Type.apply(T,M),A))))))"
    },
    "contribution_info": null,
    "pointer": null
  },
  {
    "id": "FP.def.lift",
    "kind": "definition",
    "title": "Lift Operation",
    "content": {
      "snl": "def-hyp(Type.judge(@x,Type.apply(M,A)),FP.lift(T,M,x),%the canonical embedding into the transformed monad%)"
    },
    "contribution_info": null,
    "pointer": null
  },
  {
    "id": "FP.prop.transformerLiftPure",
    "kind": "property",
    "title": "Lift Preserves Pure",
    "content": {
      "snl": "thm-hyp(Type.judge(@a,A),Eq(FP.lift(T,M,FP.pure(M,a)),FP.pure(Type.apply(T,M),a)))"
    },
    "contribution_info": null,
    "pointer": null
  },
  {
    "id": "FP.prop.transformerLiftBind",
    "kind": "property",
    "title": "Lift Preserves Bind",
    "content": {
      "snl": "thm-hyp(list-partial(Type.judge(@x,Type.apply(M,A)),Type.judge(@f,Type.to(A,Type.apply(M,B)))),Eq(FP.lift(T,M,FP.bind(M,x,f)),FP.bind(Type.apply(T,M),FP.lift(T,M,x),Type.lambda(@a,FP.lift(T,M,Type.apply(f,a))))))"
    },
    "contribution_info": null,
    "pointer": null
  },
  {
    "id": "FP.def.monadOrder",
    "kind": "definition",
    "title": "Ordered Monad",
    "content": {
      "snl": "def-struct(FP.OrderedMonad(M),struct[enumerate](member[colon](%order%,Type.Pi(@A,Type,FP.PartialOrder(Type.apply(M,A)))),member[colon](%pure monotone%,FP.monotone(FP.pure(M,@a))),member[colon](%bind monotone%,FP.monotone(FP.bind(M,@x,@f)))))"
    },
    "contribution_info": null,
    "pointer": null
  },
  {
    "id": "FP.def.monadLattice",
    "kind": "definition",
    "title": "Monad Lattice",
    "content": {
      "snl": "def-struct(FP.MonadLattice(M),struct[enumerate](member[colon](%ordered monad%,FP.OrderedMonad(M)),member[colon](%lattice%,Type.Pi(@A,Type,FP.Lattice(Type.apply(M,A))))))"
    },
    "contribution_info": null,
    "pointer": null
  },
  {
    "id": "FP.prop.pureMonotone",
    "kind": "property",
    "title": "Pure is Monotone",
    "content": {
      "snl": "thm-hyp(FP.le(@a,@b),FP.le(FP.pure(M,a),FP.pure(M,b)))"
    },
    "contribution_info": null,
    "pointer": null
  },
  {
    "id": "FP.prop.bindMonotone",
    "kind": "property",
    "title": "Bind is Monotone",
    "content": {
      "snl": "thm-hyp(list-partial(FP.le(@x,@y),Logic.forall-typed(@a,A,FP.le(Type.apply(@f,a),Type.apply(@g,a)))),FP.le(FP.bind(M,x,f),FP.bind(M,y,g)))"
    },
    "contribution_info": null,
    "pointer": null
  },
  {
    "id": "FP.prop.bindBottom",
    "kind": "property",
    "title": "Bottom is a Left Zero for Bind",
    "content": {
      "snl": "thm-hyp(Type.judge(@f,Type.to(A,Type.apply(M,B))),Eq(FP.bind(M,FP.bottom(M,A),f),FP.bottom(M,B)))"
    },
    "contribution_info": null,
    "pointer": null
  },
  {
    "id": "FP.prop.bindSup",
    "kind": "property",
    "title": "Bind Distributes over Binary Join",
    "content": {
      "snl": "thm-hyp(list-partial(Type.judge(@x,Type.apply(M,A)),Type.judge(@y,Type.apply(M,A)),Type.judge(@f,Type.to(A,Type.apply(M,B)))),Eq(FP.bind(M,FP.sup(x,y),f),FP.sup(FP.bind(M,x,f),FP.bind(M,y,f))))"
    },
    "contribution_info": null,
    "pointer": null
  },
  {
    "id": "FP.def.identity",
    "kind": "definition",
