  {
    "id": "Logic.def.and",
    "kind": "definition",
    "title": "Conjunction",
    "content": {
      "snl": "def(Logic.and(P@Logic.ctxt.PQ,Q@Logic.ctxt.PQ), Type.judge(Logic.and(P@Logic.ctxt.PQ,Q@Logic.ctxt.PQ), Proposition))"
    },
    "contribution_info": null,
