  {
    "id": "Set.def.set",
    "kind": "definition",
    "title": "Set",
    "content": {
      "snl": "def(Set(T@Set.ctxt.T), Type.to(T@Set.ctxt.T, Proposition))"
    },
    "contribution_info": null,
    "pointer": null
  },
  {
    "id": "Set.def.mem",
    "kind": "definition",
    "title": "Membership",
    "content": {
      "snl": "def-hyp(hyp-list(Type.judge(@x,T@Set.ctxt.T),Type.judge(@S,Set(T@Set.ctxt.T))),Set.mem(x,S),Type.apply[paren](S,x))"
    },
    "contribution_info": null,
    "pointer": null
  },
  {
    "id": "Set.def.sep",
    "kind": "definition",
    "title": "Set Comprehension",
    "content": {
      "snl": "def-hyp(Type.judge[paren](@P,Type.to(T@Set.ctxt.T,Proposition)),Set.sep-typed(@x,T@Set.ctxt.T,P(x)),P)"
    },
    "contribution_info": null,
    "pointer": null
  },
  {
    "id": "Set.def.emptyset",
    "kind": "definition",
    "title": "Empty Set",
    "content": {
      "snl": "def(Set.emptyset[slim],Set.sep-typed(@x,T@Set.ctxt.T,Logic.false))"
    },
    "contribution_info": null,
    "pointer": null
  },
  {
    "id": "Set.def.univ",
    "kind": "definition",
    "title": "Universal Set",
    "content": {
      "snl": "def(Set.univ,Set.sep-typed(@x,T@Set.ctxt.T,Logic.neg(Logic.false)))"
    },
    "contribution_info": null,
    "pointer": null
  },
  {
    "id": "Set.def.subset",
    "kind": "definition",
    "title": "Subset",
    "content": {
      "snl": "def(Set.subset(A@Set.ctxt.AB,B@Set.ctxt.AB),Logic.forall(@x,Logic.implies(Set.mem(x,A@Set.ctxt.AB),Set.mem(x,B@Set.ctxt.AB))))"
    },
    "contribution_info": null,
    "pointer": null
  },
  {
    "id": "Set.def.ext",
    "kind": "property",
    "title": "Set Extensionality",
    "content": {
      "snl": "thm-hyp(Type.judge[paren](hyp-list(A@Set.ctxt.AB,B@Set.ctxt.AB),Set(T@Set.ctxt.T)),Logic.iff(Eq(A@Set.ctxt.AB,B@Set.ctxt.AB), Logic.forall-typed(@x, T@Set.ctxt.T,parentheses(Logic.iff(Set.mem(x,A@Set.ctxt.AB),Set.mem(x,B@Set.ctxt.AB)))),Logic.and(Set.subset(A@Set.ctxt.AB,B@Set.ctxt.AB),Set.subset(B@Set.ctxt.AB,A@Set.ctxt.AB))))"
    },
    "contribution_info": null,
    "pointer": null
  },
  {
    "id": "Set.def.nmem",
    "kind": "definition",
    "title": "Membership Negation",
    "content": {
      "snl": "def-hyp[predicate](hyp-list(Type.judge(@x,T@Set.ctxt.T),Type.judge(A@Set.ctxt.AB,Set(T@Set.ctxt.T))),Set.nmem(x,A@Set.ctxt.AB),Logic.neg(Set.mem(x,A@Set.ctxt.AB)))"
    },
    "contribution_info": null,
    "pointer": null
  },
  {
    "id": "Set.def.union",
    "kind": "definition",
    "title": "Union of sets",
    "content": {
      "snl": "def(Set.union(A@Set.ctxt.AB,B@Set.ctxt.AB),Set.sep-typed(@x,T@Set.ctxt.T,Logic.or(Set.mem(x,A@Set.ctxt.AB),Set.mem(x,B@Set.ctxt.AB))))"
    },
    "contribution_info": null,
    "pointer": null
  },
  {
    "id": "Set.def.inter",
    "kind": "definition",
    "title": "Intersection of sets",
    "content": {
      "snl": "def(Set.inter(A@Set.ctxt.AB,B@Set.ctxt.AB),Set.sep-typed(@x,T@Set.ctxt.T,Logic.and(Set.mem(x,A@Set.ctxt.AB),Set.mem(x,B@Set.ctxt.AB))))"
    },
    "contribution_info": null,
    "pointer": null
  },
  {
    "id": "Set.def.diff",
    "kind": "definition",
    "title": "Set Difference",
    "content": {
      "snl": "def(Set.diff[backslash](A@Set.ctxt.AB,B@Set.ctxt.AB),Set.sep-typed(@x,T@Set.ctxt.T,Logic.and(Set.mem(x,A@Set.ctxt.AB),Set.nmem(x,B@Set.ctxt.AB))))"
    },
    "contribution_info": null,
    "pointer": null
  },
  {
    "id": "Set.def.compl",
    "kind": "definition",
    "title": "Complement",
    "content": {
      "snl": "def(Set.compl(A@Set.ctxt.AB),Set.sep-typed(@x,T@Set.ctxt.T,Set.nmem(x,A@Set.ctxt.AB)))"
    },
    "contribution_info": null,
    "pointer": null
  },
  {
    "id": "Set.def.powerset",
    "kind": "definition",
    "title": "Power Set",
    "content": {
      "snl": "def(Set.powerset(A@Set.ctxt.AB),Set.sep-typed(@t,Set(T@Set.ctxt.T),Set.subset(t,A@Set.ctxt.AB)))"
    },
    "contribution_info": null,
    "pointer": null
  },
  {
    "id": "Set.def.symmetric_difference",
    "kind": "definition",
    "title": "Symmetric Difference",
    "content": {
      "snl": "def(Set.SymmDiff(A@Set.ctxt.AB,B@Set.ctxt.AB),Set.diff(parentheses(Set.union(A@Set.ctxt.AB,B@Set.ctxt.AB)),parentheses(Set.inter(A@Set.ctxt.AB,B@Set.ctxt.AB))))"
    },
    "contribution_info": null,
    "pointer": null
  },
