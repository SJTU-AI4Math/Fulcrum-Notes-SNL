  {
    "id": "Logic.def.and",
    "kind": "definition",
    "title": "Conjunction",
    "content": {
      "snl": "def-struct[prop](Logic.and(P,Q),struct(Type.judge(%left%,P),Type.judge(%right%,Q)))"
    },
    "contribution_info": null,
    "pointer": null
  },
  {
    "id": "Logic.def.or",
    "kind": "definition",
    "title": "Disjunction",
    "content": {
      "snl": "def-inductive[prop](Logic.or(P,Q),ctors(Type.judge(%left%,P),Type.judge(%right%,Q)))"
    },
    "contribution_info": null,
    "pointer": null
  },
  {
    "id": "Logic.def.implies",
    "kind": "definition",
    "title": "Implication",
