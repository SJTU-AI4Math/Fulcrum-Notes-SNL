      "snl": "Type.judge(@T,Type)"
    },
    "contribution_info": null,
    "pointer": null
  },
  {
    "id": "Logic.ctxt.PQ",
    "kind": "context",
    "title": "$P, Q$",
    "content": {
      "snl": "Type.judge(hyp-list(@P,@Q),Type.to(T,Proposition))"
    },
    "contribution_info": null,
    "pointer": null
  },
  {
    "id": "Logic.subsec.propositional",
    "kind": "subsection",
    "title": "Propositional Logic",
    "content": {},
    "contribution_info": null,
    "pointer": null
  },
  {
    "id": "Logic.subsec.predicate",
    "kind": "subsection",
    "title": "Predicate Logic",
    "content": {},
    "contribution_info": null,
    "pointer": null
  },
  {
    "id": "Logic.def.true",
    "kind": "definition",
    "title": "True",
    "content": {
      "snl": "def-hyp(Type.judge(@P,Proposition), Logic.true, Type.judge(Logic.true, Proposition))"
    },
    "contribution_info": null,
    "pointer": null
  },
  {
    "id": "Logic.def.and",
    "kind": "definition",
    "title": "Conjunction",
    "content": {
      "snl": "def-hyp(hyp-list(Type.judge(@P,Proposition),Type.judge(@Q,Proposition)), Logic.and(P,Q), Type.judge(Logic.and(P,Q), Proposition))"
    },
    "contribution_info": null,
    "pointer": null
  },
  {
    "id": "Logic.def.or",
    "kind": "definition",
    "title": "Disjunction",
    "content": {
      "snl": "def-hyp(hyp-list(Type.judge(@P,Proposition),Type.judge(@Q,Proposition)), Logic.or(P,Q), Type.judge(Logic.or(P,Q), Proposition))"
    },
    "contribution_info": null,
    "pointer": null
  },
  {
    "id": "Logic.def.implies",
    "kind": "definition",
    "title": "Implication",
    "content": {
      "snl": "def-hyp(hyp-list(Type.judge(@P,Proposition),Type.judge(@Q,Proposition)), Logic.implies(P,Q), Type.judge(Logic.implies(P,Q), Proposition))"
    },
    "contribution_info": null,
    "pointer": null
  },
  {
    "id": "Logic.def.neg",
    "kind": "definition",
    "title": "Negation",
    "content": {
      "snl": "def-hyp(Type.judge(@P,Proposition), Logic.neg(P), Type.judge(Logic.neg(P), Proposition))"
    },
    "contribution_info": null,
    "pointer": null
  },
  {
    "id": "Logic.def.iff",
    "kind": "definition",
    "title": "Equivalence",
    "content": {
      "snl": "def-hyp(hyp-list(Type.judge(@P,Proposition),Type.judge(@Q,Proposition)), Logic.iff(P,Q), Type.judge(Logic.iff(P,Q), Proposition))"
    },
    "contribution_info": null,
    "pointer": null
  },
  {
    "id": "Logic.def.forall",
    "kind": "definition",
    "title": "Universal Quantifier",
    "content": {
      "snl": "def-hyp(hyp-list(Type.judge(@T,Type),Type.judge[paren](@P,Type.to(T,Proposition))), Logic.forall-typed(@x,T,P(x)), Type.judge(Logic.forall-typed(x,T,P(x)), Proposition))"
    },
    "contribution_info": null,
    "pointer": null
  },
  {
    "id": "Logic.def.exists",
    "kind": "definition",
    "title": "Existential Quantifier",
    "content": {
      "snl": "def-hyp(hyp-list(Type.judge(@T,Type),Type.judge[paren](@P,Type.to(T,Proposition))), Logic.exists-typed(@x,T,P(x)), Type.judge(Logic.exists-typed(x,T,P(x)), Proposition))"
    },
    "contribution_info": null,
    "pointer": null
  },
  {
    "id": "Logic.def.eq",
    "kind": "definition",
    "title": "Equality",
    "content": {
      "snl": "def-hyp(hyp-list(Type.judge(@T,Type),Type.judge[paren](hyp-list(@a,@b),T)), Eq(a,b), Type.judge(Eq(a,b), Proposition))"
    },
    "contribution_info": null,
    "pointer": null
  },
  {
    "id": "Logic.thm.eq_refl",
    "kind": "theorem",
    "title": "Reflexivity of =",
    "content": {
      "snl": "thm-hyp(Type.judge(@T,Type), Logic.forall-typed(@a,T,Eq(a,a)), Logic.true)"
    },
    "contribution_info": null,
    "pointer": null
  },
  {
    "id": "Logic.thm.eq_subst",
    "kind": "theorem",
    "title": "Substitution",
    "content": {
      "snl": "thm-hyp(hyp-list(Type.judge(@T,Type),Type.judge[paren](hyp-list(@a,@b),T)), Logic.implies(Eq(a,b), Logic.forall-typed(@P,Type.to(T,Proposition),Logic.implies(P(a),P(b)))), Logic.true)"
    },
    "contribution_info": null,
    "pointer": null
  }
]