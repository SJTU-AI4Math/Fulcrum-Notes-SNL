  {
    "id": "Algebra.def.groupHom",
    "kind": "definition",
    "title": "Group Homomorphism",
    "content": {
      "snl": "def-hyp(list-partial(Type.judge(@H,Type),Type.judge(@dotH,Type.to(H,Type.to(H,H))),Type.judge(@f,Type.to(G@Algebra.ctxt.G,H))), Algebra.GHom, Logic.and(Eq(Type.apply[paren](f,Algebra.e),Algebra.e),Logic.forall-typed(@a,G@Algebra.ctxt.G,Logic.forall-typed(@b,G@Algebra.ctxt.G,Eq(Type.apply[paren](f,Algebra.mul[dot](a,b)),dotH(Type.apply[paren](f,a),Type.apply[paren](f,b)))))))"
    },
    "contribution_info": null,
    "pointer": null
  },
  {
    "id": "Algebra.def.groupMono",
    "kind": "definition",
    "title": "Group Monomorphism",
    "content": {
      "snl": "def-hyp(list-partial(Type.judge(@f,Type.to(G@Algebra.ctxt.G,H))), Algebra.GMono, Logic.and(Algebra.GHom,Logic.forall-typed(@a,G@Algebra.ctxt.G,Logic.forall-typed(@b,G@Algebra.ctxt.G,Logic.implies(Eq(Type.apply[paren](f,a),Type.apply[paren](f,b)),Eq(a,b))))))"
    },
    "contribution_info": null,
    "pointer": null
  },
  {
    "id": "Algebra.def.groupEpi",
    "kind": "definition",
    "title": "Group Epimorphism",
    "content": {
      "snl": "def-hyp(list-partial(Type.judge(@H,Type),Type.judge(@dotH,Type.to(H,Type.to(H,H))),Type.judge(@f,Type.to(G@Algebra.ctxt.G,H))), Algebra.GEpi, Logic.and(Algebra.GHom,Logic.forall-typed(@y,H,Logic.exists-typed(@x,G@Algebra.ctxt.G,Eq(Type.apply[paren](f,x),y)))))"
    },
    "contribution_info": null,
    "pointer": null
  },
  {
    "id": "Algebra.def.groupIso",
    "kind": "definition",
    "title": "Group Isomorphism",
    "content": {
      "snl": "def-hyp(list-partial(Type.judge(@H,Type),Type.judge(@dotH,Type.to(H,Type.to(H,H))),Type.judge(@f,Type.to(G@Algebra.ctxt.G,H))), Algebra.GIso, Logic.and(Algebra.GMono,Algebra.GEpi))"
    },
    "contribution_info": null,
    "pointer": null
  },
  {
    "id": "Algebra.def.kernel",
    "kind": "definition",
