        "values": {
          "zh-CN": "$k\\cdot v=\\boldsymbol{0}_V$ 当且仅当 $k=0$ 或 $v=\\boldsymbol{0}_V$。",
          "en": "$k\\cdot v=\\boldsymbol{0}_V$ iff $k=0$ or $v=\\boldsymbol{0}_V$."
