      "markdown": {
        "type": "i18n",
        "default_language": "en",
        "values": {
          "en": "For `A B : Type`, the sum type `A ⊕ B` is generated by `inl : A → A ⊕ B` and `inr : B → A ⊕ B`.",
          "zh-CN": "给定 `A B : Type`，和类型 `A ⊕ B` 由 `inl : A → A ⊕ B` 与 `inr : B → A ⊕ B` 生成。"
        }
      },
      "snl": "def-inductive-hyp(Type.judge(list-partial[formula](@A,@B),Type),Type.Sum(A,B),ctors(Type.judge(Sum.inl,Type.to(A,Type.Sum(A,B))),Type.judge(Sum.inr,Type.to(B,Type.Sum(A,B)))))"
    },
