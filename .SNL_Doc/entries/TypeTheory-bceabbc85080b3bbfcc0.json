      "snl": "def-hyp(list-partial(Type.judge(@a,Lambda.Expr),Type.judge(list-partial[formula](@d,@c),Nat)),Lambda.shift(d,c,a),Type.pattern.match(a,Type.pattern.branches(Type.pattern.branch(Type.pattern.constructor(Lambda.pattern.bvar,Type.pattern.arguments(@k)),Type.piecewise(Type.piecewise.branch(Type.Expr-UTLC.bvar[hash](k),Lt(k,c)),Type.piecewise.branch(Type.Expr-UTLC.bvar[hash](Add.add(k,d)),Logic.neg(Lt(k,c))))),Type.pattern.branch(Type.pattern.constructor(Lambda.pattern.lambda,Type.pattern.arguments(@t)),Type.Expr-UTLC.lambda(@$ $ ,Lambda.shift(d,Nat.succ(c),t))),Type.pattern.branch(Type.pattern.constructor(Lambda.pattern.app,Type.pattern.arguments(@f,@u)),Type.Expr-UTLC.apply(Lambda.shift(d,c,f),Lambda.shift(d,c,u))))))",
      "markdown": {
