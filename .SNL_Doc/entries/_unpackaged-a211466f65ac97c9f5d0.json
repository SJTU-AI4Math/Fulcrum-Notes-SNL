    "title": "Borel Measure on the Real Line",
    "content": {
      "snl": "def-hyp(Type.judge(@$\\nu$,Type.to(Measure.Borel(Real),ENNReal)),Measure.BorelMeasure($\\nu$),Logic.forall-typed[paren](list-partial(@a,@b),Real,Eq(Measure.apply($\\nu$,Measure.interval(a,b)),Measure.length(a,b))))"
    },
