      "values": {
        "en": "A Positive Number Has Negative Negation",
        "zh-CN": "正数的相反数为负数"
      }
    },
    "content": {
      "snl": "thm-hyp(Type.annotation(@a,Real),Logic.iff(Lt(neg(a),0),Gt(a,0)))",
      "markdown": {
        "type": "i18n",
        "default_language": "en",
        "values": {
          "en": "For a real number `a`, the inequality `-a < 0` is equivalent to `a > 0`.",
          "zh-CN": "对实数 `a`，不等式 `-a < 0` 等价于 `a > 0`。"
        }
