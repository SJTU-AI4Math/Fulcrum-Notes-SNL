        "type": "i18n",
        "default_language": "zh-CN",
        "values": {
          "zh-CN": "楔积是交错的：$u\\wedge u=0$，从而 $u\\wedge v=-(v\\wedge u)$。",
          "en": "The wedge is alternating: $u\\wedge u=0$, hence $u\\wedge v=-(v\\wedge u)$."
        }
