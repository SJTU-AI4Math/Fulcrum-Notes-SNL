      "snl": "variable(__list__(Type.annotation(@$\\mathbb{K}$,Type),Type.annotation(@V,Type),LA.Field($\\mathbb{K}$),LA.VectorSpace(V,$\\mathbb{K}$),Type.annotation(@u,V),Type.annotation(@v,V)),theorem($u \\wedge u = 0 \\quad\\text{and}\\quad u \\wedge v = -\\,(v \\wedge u)$))",
