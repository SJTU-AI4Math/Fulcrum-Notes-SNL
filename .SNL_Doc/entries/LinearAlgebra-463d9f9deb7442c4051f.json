  "entry": {
    "id": "LinearAlgebra.example.containsZero",
    "package": "LinearAlgebra",
    "kind": "example",
    "title": {
      "type": "i18n",
      "default_language": "zh-CN",
      "values": {
        "zh-CN": "含零向量的向量族",
        "en": "A Family Containing the Zero Vector"
      }
    },
    "content": {
      "snl": "thm-hyp(list-partial(list-partial(\n  LA.VectorSpace(V@LinearAlgebra.ctxt.vectorSpace, $\\mathbb{K}$@LinearAlgebra.ctxt.vectorSpace),\n  Type.annotation(@n@LinearAlgebra.ctxt.finiteFamily, Nat),\n  Type.annotation(@$\\alpha$@LinearAlgebra.ctxt.finiteFamily, Type.to(LA.Fin(n@LinearAlgebra.ctxt.finiteFamily), V@LinearAlgebra.ctxt.vectorSpace))\n), LA.Contains($\\alpha$@LinearAlgebra.ctxt.finiteFamily, n@LinearAlgebra.ctxt.finiteFamily, LA.Zero(V@LinearAlgebra.ctxt.vectorSpace))), LA.LinearlyDependent($\\alpha$@LinearAlgebra.ctxt.finiteFamily, V@LinearAlgebra.ctxt.vectorSpace))",
      "markdown": {
        "type": "i18n",
        "default_language": "zh-CN",
        "values": {
          "zh-CN": "任何含零向量的有限向量族都线性相关：给零向量系数 $1$，其余系数 $0$。",
          "en": "Every finite family containing the zero vector is dependent: assign coefficient $1$ to that occurrence and $0$ elsewhere."
        }
      }
    },
    "contribution_info": null,
    "pointer": null
  }
