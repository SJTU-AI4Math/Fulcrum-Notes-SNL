    {
      "id": "Topology.def.isolatedPoint",
      "canonical": {
        "id": "Topology.def.isolatedPoint",
        "kind": "definition",
        "title": {
          "type": "i18n",
          "default_language": "en",
          "values": {
            "en": "Isolated Point",
            "zh-CN": "孤立点"
          }
        },
        "content": {
          "snl": "def-hyp[predicate](\r\n    list-partial(\r\n        Type.annotation(@A, Set(T@Set.ctxt.T)),\r\n        Type.annotation(@x, T@Set.ctxt.T),\r\n        Set.mem(x, S@Topology.ctxt.S)\r\n    ),\r\n    Topology.isolatedPoint(x, A),\r\n    Logic.and(\r\n        Set.mem(x, A),\r\n        Logic.neg(Set.mem(x, Topology.derivedSet(A)))\r\n    )\r\n)"
        },
        "contribution_info": null,
        "pointer": null,
        "package": "Topology"
      },
