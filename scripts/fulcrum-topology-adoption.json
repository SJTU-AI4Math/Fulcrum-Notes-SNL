      ],
      "accepted_absent": false
    },
    {
      "id": "Topology.def.closure",
      "canonical": {
        "id": "Topology.def.closure",
        "kind": "definition",
        "title": {
          "type": "i18n",
          "default_language": "en",
          "values": {
            "en": "Closure",
            "zh-CN": "闭包"
          }
        },
        "content": {
          "snl": "def-hyp(\r\n    Type.annotation(@A, Set(T@Set.ctxt.T)),\r\n    Topology.closure(A),\r\n    Set.sep-typed(\r\n        @x,\r\n        S@Topology.ctxt.S,\r\n        Logic.forall-typed(\r\n            @F,\r\n            Set(T@Set.ctxt.T),\r\n            Logic.implies(\r\n                Logic.and(Topology.closedSet(F, τ@Topology.ctxt.tau, S@Topology.ctxt.S), Set.subset(A, F)),\r\n                Set.mem(x, F)\r\n            )\r\n        )\r\n    )\r\n)"
        },
        "contribution_info": null,
        "pointer": null,
        "package": "Topology"
      },
      "accepted_predecessor_sha256": [
        "bfd9d03f5c1e98b81718524fbe65cc3e9523768c0b85f7792c992cdd9bba0f99",
        "47a95864b6bb1d844ae525ec0a04bfa83d736fb186e2348fc3c9fd5dd7792cda"
      ],
      "accepted_absent": false
    },
    {
      "id": "Topology.def.closurePoint",
      "canonical": {
        "id": "Topology.def.closurePoint",
        "kind": "definition",
        "title": {
          "type": "i18n",
          "default_language": "en",
          "values": {
            "en": "Closure Point",
            "zh-CN": "闭包点"
          }
        },
        "content": {
          "snl": "def-hyp(\r\n    list-partial(\r\n        Type.annotation(@A, Set(T@Set.ctxt.T)),\r\n        Type.annotation(@x, S@Topology.ctxt.S)\r\n    ),\r\n    Topology.closurePoint(x, A),\r\n    Logic.forall-typed(\r\n        @U,\r\n        Set(T@Set.ctxt.T),\r\n        Logic.implies(\r\n            Topology.neighborhood(U, x),\r\n            Neq(Set.inter(U, A), Set.emptyset)\r\n        )\r\n    )\r\n)"
        },
        "contribution_info": null,
        "pointer": null,
        "package": "Topology"
      },
      "accepted_predecessor_sha256": [
        "99270867fedc71306cb23dd15df1da3c24fe7fc8abc3dd71d2c10efea4e8a7ec"
      ],
      "accepted_absent": false
    },
    {
      "id": "Topology.def.compactness",
      "canonical": {
        "id": "Topology.def.compactness",
        "kind": "definition",
        "title": {
          "type": "i18n",
          "default_language": "en",
          "values": {
            "en": "Compactness",
            "zh-CN": "紧性"
          }
        },
        "content": {
          "snl": "def-hyp[predicate](\r\n    Type.annotation(@A, Set(T@Set.ctxt.T)),\r\n    Topology.compact(A),\r\n    Logic.forall-typed(\r\n        @C,\r\n        Set(Set(T@Set.ctxt.T)),\r\n        Logic.implies(\r\n            Topology.openCover(C, A),\r\n            Logic.exists-typed(\r\n                @F,\r\n                Set(Set(T@Set.ctxt.T)),\r\n                Logic.and(Set.subset(F, C), Logic.and(Topology.openCover(F, A), %势有限（将来用 `card` 替换）%))\r\n            )\r\n        )\r\n    )\r\n)"
        },
        "contribution_info": null,
        "pointer": null,
        "package": "Topology"
      },
      "accepted_predecessor_sha256": [
        "c4b5685f39815ddc5478f126f9e0817628df07242d41ac3c833a6fde19254347"
      ],
      "accepted_absent": false
    },
    {
      "id": "Topology.def.connected",
      "canonical": {
        "id": "Topology.def.connected",
        "kind": "definition",
        "title": {
          "type": "i18n",
          "default_language": "en",
          "values": {
            "en": "Connectedness",
            "zh-CN": "连通性"
          }
        },
        "content": {
          "snl": "def-hyp(\r\n    Type.annotation(@A, Set(T@Set.ctxt.T)),\r\n    Topology.connected(A),\r\n    Logic.neg(\r\n        Logic.exists-typed(\r\n            @U,\r\n            Set(T@Set.ctxt.T),\r\n            Logic.exists-typed(\r\n                @V,\r\n                Set(T@Set.ctxt.T),\r\n                Logic.and(\r\n                    Logic.and(Set.mem(U, τ@Topology.ctxt.tau), Set.mem(V, τ@Topology.ctxt.tau)),\r\n                    Logic.and(\r\n                        Logic.and(Set.subset(U, A), Set.subset(V, A)),\r\n                        Logic.and(\r\n                            Logic.and(Logic.neg(Set.mem(U, Set.emptyset[slim])), Logic.neg(Set.mem(V, Set.emptyset[slim]))),\r\n                            Logic.and(Eq(Set.inter(U, V), Set.emptyset[slim]), Eq(A, Set.union(U, V)))\r\n                        )\r\n                    )\r\n                )\r\n            )\r\n        )\r\n    )\r\n)"
        },
        "contribution_info": null,
        "pointer": null,
        "package": "Topology"
      },
      "accepted_predecessor_sha256": [
        "c4be98ae5c68d8e291a0f5dc9e0bc7f79bafe91832e744e37e2e9861ab365317"
      ],
      "accepted_absent": false
    },
    {
      "id": "Topology.def.continuityAtPoint",
      "canonical": {
        "id": "Topology.def.continuityAtPoint",
        "kind": "definition",
        "title": {
          "type": "i18n",
          "default_language": "en",
          "values": {
            "en": "Continuity at a Point",
            "zh-CN": "点处连续性"
          }
        },
        "content": {
          "snl": "def-hyp(\r\n    list-partial(\r\n        Type.annotation(@x, X@Topology.ctxt.X),\r\n        Type.annotation(@x_0, X@Topology.ctxt.X),\r\n        Type.annotation(@f, Type.to(X@Topology.ctxt.X, Y@Topology.ctxt.Y))\r\n    ),\r\n    Topology.continuous(f, x_0),\r\n    Topology.mapLimit(x, x_0, f, Type.apply(f, x_0))\r\n)"
        },
        "contribution_info": null,
        "pointer": null,
        "package": "Topology"
      },
      "accepted_predecessor_sha256": [
        "c468a14e3945b39f2e3a9e6b69f0c41fa1293e908432f963572a5d679858106c"
      ],
      "accepted_absent": false
    },
    {
      "id": "Topology.def.countablyCompact",
      "canonical": {
        "id": "Topology.def.countablyCompact",
        "kind": "definition",
        "title": {
          "type": "i18n",
          "default_language": "en",
          "values": {
            "en": "Countable Compactness",
            "zh-CN": "可数紧性"
          }
        },
        "content": {
          "snl": "def-hyp(\r\n    Type.annotation(@A, Set(T@Set.ctxt.T)),\r\n    Topology.countablyCompact(A),\r\n    Logic.forall-typed(\r\n        @C,\r\n        Set(Set(T@Set.ctxt.T)),\r\n        Logic.implies(\r\n            Topology.openCover(C, A),\r\n            Logic.exists-typed(\r\n                @F,\r\n                Set(Set(T@Set.ctxt.T)),\r\n                Logic.and(Set.subset(F, C), Logic.and(Topology.openCover(F, A), %具有可数势（未来用 `card` 替换）%))\r\n            )\r\n        )\r\n    )\r\n)"
        },
        "contribution_info": null,
        "pointer": null,
        "package": "Topology"
      },
      "accepted_predecessor_sha256": [
        "79209486fcf1785f2341417c8235f0fea7573431430173dde1c99964e9408356"
      ],
      "accepted_absent": false
    },
    {
      "id": "Topology.def.deletedNeighborhood",
      "canonical": {
        "id": "Topology.def.deletedNeighborhood",
        "kind": "definition",
        "title": {
          "type": "i18n",
          "default_language": "en",
          "values": {
            "en": "Deleted Neighborhood",
            "zh-CN": "去心邻域"
          }
        },
        "content": {
          "snl": "def-hyp(\r\n    list-partial(\r\n        Type.annotation(@x, T@Set.ctxt.T),\r\n        Set.mem(x, S@Topology.ctxt.S),\r\n        Type.annotation(@U, Set(T@Set.ctxt.T)),\r\n        Set.subset(U, S@Topology.ctxt.S)\r\n    ),\r\n    Topology.deletedNeighborhood(U, x),\r\n    Logic.and(\r\n        Topology.neighborhood(\r\n            Set.union(U, Set.sep-typed(@y, T@Set.ctxt.T, Eq(y, x))),\r\n            x\r\n        ),\r\n        Logic.neg(Set.mem(x, U))\r\n    )\r\n)"
        },
        "contribution_info": null,
        "pointer": null,
        "package": "Topology"
      },
      "accepted_predecessor_sha256": [
        "91e015c3fff8db3239121dea65563e6e32d0b208690fafd698ece1b79bf67514"
      ],
      "accepted_absent": false
    },
    {
      "id": "Topology.def.denseSet",
      "canonical": {
        "id": "Topology.def.denseSet",
        "kind": "definition",
        "title": {
          "type": "i18n",
          "default_language": "en",
          "values": {
