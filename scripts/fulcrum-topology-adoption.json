            "zh-CN": "导集"
          }
        },
        "content": {
          "snl": "def-hyp(Type.annotation(@A, Set(T@Set.ctxt.T)), Topology.derivedSet(A), Set.sep-typed(@x, T@Set.ctxt.T, Topology.limitPoint(x, A)))"
        },
