    {
      "id": "Topology.def.generatedTopology",
      "canonical": {
        "id": "Topology.def.generatedTopology",
        "kind": "definition",
        "title": {
          "type": "i18n",
          "default_language": "en",
          "values": {
            "en": "Generated Topology",
            "zh-CN": "生成拓扑"
          }
        },
        "content": {
          "snl": "def-hyp(\r\n    list-partial(Type.annotation(@$\\mathcal{B}$, Set(Set(T@Set.ctxt.T))), Set.subset($\\mathcal{B}$, Set.powerset(S@Topology.ctxt.S))),\r\n    Topology.generatedTopology($\\mathcal{B}$),\r\n    Set.sep-typed(\r\n        @U,\r\n        Set(T@Set.ctxt.T),\r\n        Logic.forall-typed(\r\n            @x,\r\n            T@Set.ctxt.T,\r\n            Logic.implies(\r\n                Set.mem(x, U),\r\n                Logic.exists-typed(\r\n                    @B_2,\r\n                    Set(T@Set.ctxt.T),\r\n                    Logic.and(Set.mem(B_2, $\\mathcal{B}$), Logic.and(Set.mem(x, B_2), Set.subset(B_2, U)))\r\n                )\r\n            )\r\n        )\r\n    )\r\n)"
        },
        "contribution_info": null,
        "pointer": null,
        "package": "Topology"
      },
      "accepted_predecessor_sha256": [
        "b2f43ea498eb66a2333cc17479e4174004711dd060a038b3deb9eddf24399212"
      ],
      "accepted_absent": false
    },
    {
      "id": "Topology.def.interior",
      "canonical": {
        "id": "Topology.def.interior",
        "kind": "definition",
        "title": {
          "type": "i18n",
          "default_language": "en",
          "values": {
            "en": "Interior",
            "zh-CN": "内部"
          }
        },
        "content": {
          "snl": "def-hyp(\r\n    list-partial(\r\n        Type.annotation(@A, Set(T@Set.ctxt.T)),\r\n        Set.subset(A, S@Topology.ctxt.S)\r\n    ),\r\n    Topology.interior(A),\r\n    Set.sep-typed(\r\n        @x,\r\n        T@Set.ctxt.T,\r\n        Logic.exists-typed(\r\n            @O,\r\n            Set(T@Set.ctxt.T),\r\n            Logic.and(Logic.and(Set.mem(O, τ@Topology.ctxt.tau), Set.subset(O, A)), Set.mem(x, O))\r\n        )\r\n    )\r\n)"
        },
        "contribution_info": null,
        "pointer": null,
        "package": "Topology"
      },
