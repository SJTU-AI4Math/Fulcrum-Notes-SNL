    {
      "id": "Topology.def.closedSet",
      "canonical": {
        "id": "Topology.def.closedSet",
        "kind": "definition",
        "title": {
          "type": "i18n",
          "default_language": "en",
          "values": {
            "en": "Closed Set",
            "zh-CN": "闭集"
          }
        },
        "content": {
          "snl": "def-hyp(Type.annotation(@U,Set(T@Set.ctxt.T)),Topology.closedSet[text](U,τ@Topology.ctxt.tau,S@Topology.ctxt.S),Set.mem(Set.compl[sup](U,S@Topology.ctxt.S),τ))"
        },
