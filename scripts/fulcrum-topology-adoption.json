    {
      "id": "Topology.def.neighborhood",
      "canonical": {
        "id": "Topology.def.neighborhood",
        "kind": "definition",
        "title": {
          "type": "i18n",
          "default_language": "en",
          "values": {
            "en": "Neighborhood",
            "zh-CN": "邻域"
          }
        },
        "content": {
          "snl": "def-hyp[predicate](\r\n    list-partial(\r\n        Type.annotation(@x, T@Set.ctxt.T),\r\n        Set.mem(x, S@Topology.ctxt.S),\r\n        Type.annotation(@U, Set(T@Set.ctxt.T))\r\n    ),\r\n    Topology.neighborhood(U, x),\r\n    Logic.exists-typed(\r\n        @O,\r\n        Set(T@Set.ctxt.T),\r\n        Logic.and(Logic.and(Set.mem(O, τ@Topology.ctxt.tau), Set.mem(x, O)), Set.subset(O, U))\r\n    )\r\n)"
        },
        "contribution_info": null,
        "pointer": null,
        "package": "Topology"
      },
      "accepted_predecessor_sha256": [
        "d86441c8ca57b8a6f76998d5b278e23c74768f83ad32337ecdee098d6ad7fcd5"
      ],
