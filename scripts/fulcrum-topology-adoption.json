    {
      "id": "Topology.def.limitPoint",
      "canonical": {
        "id": "Topology.def.limitPoint",
        "kind": "definition",
        "title": {
          "type": "i18n",
          "default_language": "en",
          "values": {
            "en": "Limit Point / Accumulation Point",
            "zh-CN": "极限点／聚点"
          }
        },
        "content": {
          "snl": "def-hyp(\r\n    list-partial(\r\n        Type.annotation(@A, Set(T@Set.ctxt.T)),\r\n        Type.annotation(@x, T@Set.ctxt.T),\r\n        Set.mem(x, S@Topology.ctxt.S)\r\n    ),\r\n    Topology.limitPoint(x, A),\r\n    Logic.forall-typed(\r\n        @U,\r\n        Set(T@Set.ctxt.T),\r\n        Logic.implies(\r\n            Topology.deletedNeighborhood(U, x),\r\n            Neq(Set.inter(U, A), Set.emptyset)\r\n        )\r\n    )\r\n)"
        },
        "contribution_info": null,
